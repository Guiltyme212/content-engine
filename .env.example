# Copy these names into Railway Variables. Do not commit a real key.
#
# Every text/copy call runs on a CURRENT Claude model — no legacy models (gpt-4o, gpt-4,
# gpt-3.5, o1) anywhere in the copy layer. OpenAI is for IMAGE generation only (gpt-image-2).

# Route A — Claude through an OpenAI-compatible proxy (what runs today).
MODEL_PROVIDER=proxy
MODEL_NAME=claude-opus-5
MODEL_REASONING_EFFORT=medium
PROXY_BASE_URL=
PROXY_API_KEY=

# Route B — Anthropic directly. Set this and it wins over the proxy for extraction.
ANTHROPIC_API_KEY=

# Image generation only.
OPENAI_API_KEY=

# Optional per-stage overrides. Leave blank to inherit the Claude route above.
# Brand + audience extraction falls back to claude-opus-5 and refuses to run on OpenAI.
STRUCTURED_MODEL_PROVIDER=
STRUCTURED_MODEL_NAME=
CAROUSEL_MODEL_PROVIDER=
CAROUSEL_MODEL_NAME=
CAROUSEL_MODEL_REASONING_EFFORT=low
